{
  "name": "react-bannerkit-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for react-bannerkit: a banner template builder and renderer for React.",
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "build": "pnpm --filter react-bannerkit build",
    "dev": "pnpm --filter playground dev",
    "test": "pnpm --filter react-bannerkit test",
    "test:watch": "pnpm --filter react-bannerkit test:watch",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
